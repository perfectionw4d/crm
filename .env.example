# ─── Google OAuth Credentials ─────────────────────────────────────────────────
# 1. עבור ל-console.cloud.google.com
# 2. צור פרויקט חדש (או בחר קיים)
# 3. API & Services → Enable APIs → הפעל Calendar API, Tasks API, People API
# 4. Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs: http://localhost:3000/auth/callback
# 7. העתק את ה-Client ID וה-Client Secret לכאן

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=replace-with-random-string-123
PORT=3000
